{
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKeyEnv": "OPENROUTER_API_KEY"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "NVIDIA Nemotron 3 Ultra (free)",
          "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
          "tools": true,
          "rate_limit_rpm": 20,
          "timeout_seconds": 120,
          "extra_body": {
            "reasoning": {
              "enabled": false
            }
          }
        }
      }
    }
  }
}
